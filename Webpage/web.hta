        <div class="nav-content">
            <div class="text-logo">
                <a href="#">WOX</a>
            </div>

            <!-- Text Links (Default) -->
            <div class="nav-links text-links">
                <a class="nav-link active" data-target="projects"><i class="fas fa-briefcase" style="margin-right: 10px;"></i>Projects</a>
                <a class="nav-pin" style="float: right;"><i class="fa-solid fa-thumbtack" id="pin"></i></a>
                <a class="nav-link" data-target="admin" style="float: right;"><i class="fa-solid fa-user-tie" style="margin-right: 10px;"></i>Admin</a>
            </div>

            <!-- Icon Links (Responsive) -->
            <div class="nav-links icon-links">
                <a class="nav-link-icon active" data-target="projects"><i class="fas fa-briefcase"></i></a>>
                <a class="nav-pin"><i class="fa-solid fa-thumbtack" id="pin"></i></a>
                <a class="nav-link" data-target="admin" style="float: right;"><i class="fa-solid fa-user-tie" style="margin-right: 10px;"></i>Admin</a>
            </div>
        </div>
        <!-- <div class="header-button"></div> -->
    </div>
