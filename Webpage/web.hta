<!DOCTYPE html>
<html>
<head>
    <title>HTA-Gallery</title>
    <hta:application 
        id="myHTA" 
        applicationname="HTA-Gallery" 
        border="thick" 
        innerborder="yes"
        caption="yes" 
        maximizebutton="yes" 
        minimizebutton="yes" 
        scroll="no" 
        singleinstance="yes"
        version="v1.3.5"
        windowstate="normal">
    <meta http-equiv="x-ua-compatible" content="IE=edge,chrome=1" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Xerox Artificial Intelligence (XAI)</title>
    <!-- <link rel="stylesheet" href="./CSS/Reset.css" /> -->
    <link rel="stylesheet" href="./CSS/Global.css" />
    <link rel="stylesheet" href="./CSS/Stars.css" />
    <link rel="stylesheet" href="./CSS/HeaderNavigation.css" />
    <link rel="stylesheet" href="./CSS/LeftSideNavigation.css" />
    <link rel="stylesheet" href="./CSS/ProjectNavigation.css" />
    <link rel="stylesheet" href="./CSS/FooterNavigation.css" />
    <link rel="stylesheet" href="https://unpkg.com/flickity@2/dist/flickity.min.css">
    <link rel="stylesheet" href="./CSS/AdminSection.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Orbitron:400,500,700,900">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Share+Tech+Mono">
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
</head>

